# Supabase — from Project Settings > API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Anthropic — from console.anthropic.com. Never expose this to the browser.
ANTHROPIC_API_KEY=

# Used to build absolute links (e.g. in transactional email flows).
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Cost guardrail: max AI calls (analyses, job parses, builder generations)
# per user per UTC day. Defaults to 20 if unset.
DAILY_AI_CALL_LIMIT=20
